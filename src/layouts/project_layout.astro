---
const { frontmatter } = Astro.props;
---

<article>

  <header class="project_header">

    <p class="category">
      {frontmatter.category}
    </p>

    <h1>
      {frontmatter.title}
    </h1>


    <p class="metadata">
      {frontmatter.year} · {frontmatter.status}
    </p>

  </header>


  <div class="content">

    <slot />

  </div>

</article>